### Get all members

GET http://localhost:8080/api/members
Accept: application/json

### Get one member

GET http://localhost:8080/api/members/10010
Accept: application/json

### Create a test member
POST http://localhost:8080/api/members
Content-Type: application/json

{
  "firstName": "Xev",
  "lastName": "Bellringer",
  "email": "xev@lexx.com"
}

> {%
    client.assert(response.status === 201, "Member creation failed");
    client.assert(response.body.id != null, "Response is missing member ID");
    client.global.set("testMemberId", response.body.id);
%}